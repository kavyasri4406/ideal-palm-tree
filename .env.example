# AgriPredict environment configuration
# Copy this file to .env.local for local development, or set these in your hosting provider's settings.

# Groq API key — powers the AgriBot chat, document scanner (OCR) and AI mandi estimates.
# Get a free key at https://console.groq.com/keys. Without it the app uses its offline fallbacks.
GROQ_API_KEY=your_groq_api_key
# Optional: override the Groq models (see https://console.groq.com/docs/models).
# The vision model must accept image input.
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=

# Web Push (VAPID) keys for lockscreen price alerts. Generate a pair with:
#   node scripts/gen_vapid.cjs
# Keep the private key secret. Without these, push notifications are disabled.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# Optional: secret token that allows broadcasting a push to ALL subscribers via
#   POST /api/notifications/send  with header  Authorization: Bearer <token>
# Leave empty to disable broadcasts (devices can still notify themselves).
PUSH_ADMIN_TOKEN=

# Official daily mandi prices from Agmarknet (data.gov.in). Free key: data.gov.in → "Generate API Key".
# Without it, mandi prices fall back to AI/model estimates (clearly labelled "Estimated").
DATA_GOV_API_KEY=
# data.gov.in refuses connections from some cloud hosts (Vercel, for example). Set the same key here
# and the visitor's browser fetches the official prices when the server cannot. Note: anything
# starting with NEXT_PUBLIC_ is visible to anyone who opens the site, so only use a free key.
NEXT_PUBLIC_DATA_GOV_API_KEY=

# Optional: Supabase login + database (Supabase → Project Settings → API Keys).
# Leave both empty to use simple browser-only accounts (stored on the device, not synced, and the
# chat/scanner routes are then protected by the rate limit only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key (sb_secret_... or legacy service_role) — NEVER expose to the browser.
# From Supabase → Project Settings → API Keys → Secret key. Enables durable push alert subscriptions
# (push_subscriptions table); without it they are kept in a local file / memory only.
SUPABASE_SECRET_KEY=
